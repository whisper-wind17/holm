    "LocalAvailability": {
      "description": "Whether the same version exists locally, as three distinguishable answers.\n\n``ABSENT`` is a conclusion the platform reached, not an omitted field: the\nwizard must be able to tell \"no local copy\" from \"nobody looked\".",
      "enum": [
        "artifact_ready",
        "download_active",
        "absent"
      ],
      "title": "LocalAvailability",
      "type": "string"
    },
    "ModelCatalogItemResponse": {
      "additionalProperties": false,
      "description": "Path- and credential-free projection required by the Model catalog.",
      "properties": {
        "architecture": {
          "anyOf": [
            {
              "$ref": "#/$defs/IdentifiedValue_str_"
            },
            {
              "$ref": "#/$defs/UnrecognizedValue"
            }
          ],
          "title": "Architecture"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "estimated_size_bytes": {
          "anyOf": [
            {
              "$ref": "#/$defs/IdentifiedValue_int_"
            },
            {
              "$ref": "#/$defs/UnrecognizedValue"
            }
          ],
          "title": "Estimated Size Bytes"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "local_availability": {
          "$ref": "#/$defs/LocalAvailability"
        },
        "modalities": {
          "anyOf": [
            {
