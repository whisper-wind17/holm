        },
        "revision": {
          "title": "Revision",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ModelOriginType"
        }
      },
      "required": [
        "id",
        "source",
        "display_name",
        "repository_id",
        "architecture",
        "modalities",
        "estimated_size_bytes",
        "revision",
        "local_availability",
        "references"
