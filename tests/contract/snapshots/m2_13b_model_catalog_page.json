    "UnrecognizedValue": {
      "additionalProperties": false,
      "description": "A metadata field explicitly reported as \"\u672a\u8bc6\u522b\".\n\nIt has no ``value`` key at all, so the rendering cannot degrade into\n``null``, ``\"\"``, ``0``, ``false`` or a source default.",
      "properties": {
        "state": {
          "const": "unrecognized",
          "default": "unrecognized",
          "title": "State",
          "type": "string"
